# ══════════════════════════════════════════════════════════════════════════════
# .gitignore — insideLLMs
# ══════════════════════════════════════════════════════════════════════════════
# Policy: Track all code, configs, plots, and results.
#         Exclude model weights, activations, datasets, and venvs.

# ── Python virtual environments ──────────────────────────────────────────────
venv/
.venv/
env/
ENV/
venv.bak/
.env

# ── Python caching & build artifacts ─────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/
build/
dist/
*.egg-info/
.eggs/

# ── IDE and OS files ─────────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db

# ── Heavy datasets (raw data, not results) ───────────────────────────────────
arxiv_data/
datasets/

# ── HDF5 activation files (large, regenerable) ──────────────────────────────
**/activations/
*.h5

# ── Model weights and checkpoint files ───────────────────────────────────────
*.safetensors
*.bin
*.pth
*.ckpt
*.onnx
*.pb

# ── LoRA adapter weights ────────────────────────────────────────────────────
**/adapters/

# ── PyTorch/Numpy tensor files (large intermediate data) ────────────────────
*.pt
*.npz
*.npy

# ── Old directories (kept for reference during migration) ────────────────────
older_stuff/
# KAUSTUBH/
# FineTuning/

# ══════════════════════════════════════════════════════════════════════════════
# ALWAYS TRACKED — These override the patterns above
# ══════════════════════════════════════════════════════════════════════════════

# All plots and figures
!*.png
!*.jpg
!*.jpeg
!*.pdf
!*.svg

# All results metadata and summaries
!*.json
!*.csv

# All documentation
!*.md
!*.txt
!*.tex

# All config files
!*.yaml
!*.yml
!*.toml

# Specific results directories — track their plots and JSON summaries
!results/**/*.png
!results/**/*.pdf
!results/**/*.json
!experiments/**/results/**/*.png
!experiments/**/results/**/*.pdf
!experiments/**/results/**/*.json
!paper/**
