\newlabel{fig:mixing_summary}{{4}{5}{Per-module domain mixing summary (grand mean across all layers, Epoch 3). Blue = attention modules, orange = MLP modules. \texttt {gate\_proj} is the most domain-specialised module overall (lowest mixing score). Among attention modules, \texttt {v\_proj} is the most domain-mixed.\relax }{figure.caption.8}{}}
\@writefile{toc}{\contentsline {paragraph}{Module-wise drill-down.}{6}{section*.9}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Module-wise $6 \times 6$ similarity heatmaps at Layer 5 (Epoch 3). Top row: attention modules (q/k/v\_proj). Middle: o\_proj and pooled groups. Bottom: MLP modules (gate/up/down\_proj). All share a common colour scale. \texttt  {gate\_proj} (bottom-left) shows near-zero off-diagonal similarity --- almost perfectly domain-specialised. \texttt  {v\_proj} (top-right) shows the highest cross-domain similarity within attention.\relax }}{6}{figure.caption.10}\protected@file@percent }
\newlabel{fig:modulewise}{{5}{6}{Module-wise $6 \times 6$ similarity heatmaps at Layer 5 (Epoch 3). Top row: attention modules (q/k/v\_proj). Middle: o\_proj and pooled groups. Bottom: MLP modules (gate/up/down\_proj). All share a common colour scale. \texttt {gate\_proj} (bottom-left) shows near-zero off-diagonal similarity --- almost perfectly domain-specialised. \texttt {v\_proj} (top-right) shows the highest cross-domain similarity within attention.\relax }{figure.caption.10}{}}
